{
  "name": "dw-marketplace",
  "description": "Development Workflow 工具集：全流程开发准则 + GPT 模型桥接",
  "owner": { "name": "JocuperDARY" },
  "plugins": [
    {
      "name": "development-workflow",
      "source": "./plugins/development-workflow",
