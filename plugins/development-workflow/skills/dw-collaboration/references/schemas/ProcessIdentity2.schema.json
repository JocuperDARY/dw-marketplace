{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProcessIdentity2.schema.json",
  "title": "ProcessIdentity2",
  "oneOf": [
    { "$ref": "#/$defs/windows" },
    { "$ref": "#/$defs/linux" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schema", "schema_version", "platform", "owner_id", "run_id", "session_id", "lease_generation", "adapter_generation", "manager_generation", "pid", "start_time", "executable_path_sha256", "argv_sha256", "parent_identity_sha256", "launch_nonce", "manager_run_id"],
      "properties": {
        "schema": { "const": "ProcessIdentity2" },
        "schema_version": { "const": 2 },
        "platform": { "enum": ["windows", "linux"] },
        "owner_id": { "$ref": "#/$defs/non_empty_string" },
        "run_id": { "$ref": "#/$defs/non_empty_string" },
        "session_id": { "$ref": "#/$defs/non_empty_string" },
        "lease_generation": { "$ref": "#/$defs/positive_safe_integer" },
        "adapter_generation": { "$ref": "#/$defs/positive_safe_integer" },
        "manager_generation": { "$ref": "#/$defs/positive_safe_integer" },
        "pid": { "$ref": "#/$defs/positive_safe_integer" },
        "start_time": { "$ref": "#/$defs/utc_timestamp" },
        "executable_path_sha256": { "$ref": "#/$defs/sha256" },
        "argv_sha256": { "$ref": "#/$defs/sha256" },
        "parent_identity_sha256": { "$ref": "#/$defs/sha256" },
        "launch_nonce": { "$ref": "#/$defs/non_empty_string" },
        "manager_run_id": { "$ref": "#/$defs/non_empty_string" }
      }
    },
    "windows": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["windows_identity"],
          "properties": {
            "platform": { "const": "windows" },
            "windows_identity": {
              "type": "object",
              "required": ["process_creation_time_filetime", "process_handle"],
              "properties": {
                "process_creation_time_filetime": { "$ref": "#/$defs/filetime" },
                "process_handle": { "$ref": "#/$defs/non_empty_string" }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "linux": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["linux_identity"],
          "properties": {
            "platform": { "const": "linux" },
            "linux_identity": {
              "type": "object",
              "required": ["proc_start_ticks", "boot_id_sha256", "process_group_id", "os_session_id", "executable_device_id", "executable_inode"],
              "properties": {
                "proc_start_ticks": { "$ref": "#/$defs/positive_safe_integer" },
                "boot_id_sha256": { "$ref": "#/$defs/sha256" },
                "process_group_id": { "$ref": "#/$defs/positive_safe_integer" },
                "os_session_id": { "$ref": "#/$defs/positive_safe_integer" },
                "executable_device_id": { "$ref": "#/$defs/non_empty_string" },
                "executable_inode": { "$ref": "#/$defs/positive_safe_integer" }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "non_empty_string": {
      "type": "string",
      "not": { "pattern": "^[\\u0009\\u000A\\u000B\\u000C\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]*$" }
    },
    "positive_safe_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "filetime": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+$",
      "not": { "pattern": "[\\r\\n\\u2028\\u2029]" }
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9])(?:\\.([0-9]+))?Z$",
      "not": { "pattern": "[\\r\\n\\u2028\\u2029]" }
    }
  }
}
