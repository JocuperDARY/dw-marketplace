{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SupportMatrix2.schema.json",
  "title": "SupportMatrix2",
  "type": "object",
  "required": ["schema", "schema_version", "adapter_id", "platform", "observed_at", "overall_state", "claims"],
  "properties": {
    "schema": { "const": "SupportMatrix2" },
    "schema_version": { "const": 2 },
    "adapter_id": { "$ref": "#/$defs/non_empty_string" },
    "platform": { "enum": ["windows", "linux"] },
    "observed_at": { "$ref": "#/$defs/utc_timestamp" },
    "overall_state": { "$ref": "#/$defs/support_state" },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          { "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          { "not": { "pattern": "[\\r\\n\\u2028\\u2029]" } },
          { "not": { "enum": ["constructor", "prototype"] } }
        ]
      },
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_]*$": { "$ref": "#/$defs/support_claim" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "overall_state": { "const": "VERIFIED_FULL" } } },
      "then": { "properties": { "claims": { "patternProperties": { "^[A-Za-z][A-Za-z0-9_]*$": { "$ref": "#/$defs/support_claim_full" } } } } }
    },
    {
      "if": { "properties": { "overall_state": { "const": "NOT_RUN" } } },
      "then": { "properties": { "claims": { "patternProperties": { "^[A-Za-z][A-Za-z0-9_]*$": { "$ref": "#/$defs/support_claim_not_run" } } } } }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "not": { "pattern": "^[\\u0009\\u000A\\u000B\\u000C\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]*$" }
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9])(?:\\.([0-9]+))?Z$",
      "not": { "pattern": "[\\r\\n\\u2028\\u2029]" }
    },
    "evidence_ref": { "type": "string", "minLength": 73, "maxLength": 73, "pattern": "^evidence:[0-9a-f]{64}$" },
    "support_state": {
      "enum": ["VERIFIED_FULL", "VERIFIED_DEGRADED", "UNVERIFIED", "NOT_RUN", "FAILED"]
    },
    "support_claim": {
      "type": "object",
      "required": ["state", "evidence_refs"],
      "properties": {
        "state": { "$ref": "#/$defs/support_state" },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "state": { "const": "VERIFIED_FULL" } } }, "then": { "properties": { "evidence_refs": { "minItems": 1 } } } },
        { "if": { "properties": { "state": { "const": "NOT_RUN" } } }, "then": { "properties": { "evidence_refs": { "maxItems": 0 } } } }
      ]
    },
    "support_claim_full": {
      "allOf": [
        { "$ref": "#/$defs/support_claim" },
        { "properties": { "state": { "const": "VERIFIED_FULL" }, "evidence_refs": { "minItems": 1 } } }
      ]
    },
    "support_claim_not_run": {
      "allOf": [
        { "$ref": "#/$defs/support_claim" },
        { "properties": { "state": { "const": "NOT_RUN" }, "evidence_refs": { "maxItems": 0 } } }
      ]
    }
  }
}
