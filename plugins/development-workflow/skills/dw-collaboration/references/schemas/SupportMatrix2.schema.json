{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SupportMatrix2.schema.json",
  "title": "SupportMatrix2",
  "type": "object",
  "required": ["schema", "schema_version", "adapter_id", "platform", "observed_at", "overall_state", "claims"],
  "properties": {
    "schema": { "const": "SupportMatrix2" },
    "schema_version": { "const": 2 },
    "adapter_id": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["windows", "linux"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "overall_state": { "$ref": "#/$defs/support_state" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "capability_id",
      "items": {
        "type": "object",
        "required": ["capability_id", "state", "evidence_refs"],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1 },
          "state": { "$ref": "#/$defs/support_state" },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "state": { "const": "VERIFIED_FULL" } } }, "then": { "properties": { "evidence_refs": { "minItems": 1 } } } },
          { "if": { "properties": { "state": { "const": "NOT_RUN" } } }, "then": { "properties": { "evidence_refs": { "maxItems": 0 } } } }
        ]
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "overall_state": { "const": "VERIFIED_FULL" } } },
      "then": { "properties": { "claims": { "items": { "properties": { "state": { "const": "VERIFIED_FULL" }, "evidence_refs": { "minItems": 1 } } } } } }
    },
    {
      "if": { "properties": { "overall_state": { "const": "NOT_RUN" } } },
      "then": { "properties": { "claims": { "items": { "properties": { "state": { "const": "NOT_RUN" }, "evidence_refs": { "maxItems": 0 } } } } } }
    }
  ],
  "$defs": {
    "support_state": {
      "enum": ["VERIFIED_FULL", "VERIFIED_DEGRADED", "UNVERIFIED", "NOT_RUN", "FAILED"]
    }
  }
}
