{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-workflow.local/schemas/ResourceLedger1.schema.json",
  "title": "ResourceLedger1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "artifact_id", "run_id", "session_id", "created_at", "producer", "redaction", "plan_ref", "run_events", "child_events", "resource_events", "resources", "content_sha256"],
  "properties": {
    "schema": {"const": "ResourceLedger1"},
    "schema_version": {"const": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "producer": {"$ref": "#/$defs/producer"},
    "redaction": {"$ref": "#/$defs/redaction"},
    "plan_ref": {"$ref": "#/$defs/artifactRef"},
    "run_events": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/runLifecycleEvent"}},
    "child_events": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/childLifecycleEvent"}},
    "resource_events": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/resourceEvent"}},
    "resources": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/resource"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^(\\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):([0-5]\\d):([0-5]\\d)(?:\\.(\\d+))?Z$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["role", "adapter_id"], "properties": {"role": {"enum": ["root", "child", "adapter"]}, "adapter_id": {"type": "string", "minLength": 1}}},
    "redaction": {"type": "object", "additionalProperties": false, "required": ["policy"], "properties": {"policy": {"enum": ["metadata_only", "hashed_identifiers", "approved_excerpt"]}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "stringRefs": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lifecycleEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "machine", "subject_id", "from_state", "to_state", "sequence", "observed_at", "actor_role", "actor_id", "plan_generation", "evidence_refs", "guard_refs", "supersedes_event_id"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "machine": {"enum": ["run", "child"]}, "subject_id": {"type": "string", "minLength": 1},
        "from_state": {"type": ["string", "null"]}, "to_state": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"}, "actor_role": {"type": "string", "minLength": 1}, "actor_id": {"type": "string", "minLength": 1},
        "plan_generation": {"type": "integer", "minimum": 1}, "evidence_refs": {"$ref": "#/$defs/stringRefs"}, "guard_refs": {"$ref": "#/$defs/stringRefs"},
        "supersedes_event_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "runLifecycleEvent": {"allOf": [{"$ref": "#/$defs/lifecycleEvent"}, {"properties": {"machine": {"const": "run"}}}]},
    "childLifecycleEvent": {"allOf": [{"$ref": "#/$defs/lifecycleEvent"}, {"properties": {"machine": {"const": "child"}}}]},
    "resourceEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "resource_id", "event_kind", "from_state", "to_state", "sequence", "observed_at", "actor_role", "actor_id", "lease_generation", "identity_ref", "evidence_refs", "postconditions", "supersedes_event_id"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "resource_id": {"type": "string", "minLength": 1},
        "event_kind": {"enum": ["DECLARE", "LEASE", "REQUEST_START", "OBSERVE_ACTIVE", "REQUEST_QUIESCE", "REQUEST_TERMINATE", "OBSERVE_EXIT", "BEGIN_RECLAIM", "VERIFY_RECLAIM", "RETAIN_ARTIFACT", "MARK_UNKNOWN", "QUARANTINE"]},
        "from_state": {"type": ["string", "null"]}, "to_state": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"}, "actor_role": {"type": "string", "minLength": 1}, "actor_id": {"type": "string", "minLength": 1},
        "lease_generation": {"type": "integer", "minimum": 1}, "identity_ref": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/stringRefs"},
        "postconditions": {"type": "object", "additionalProperties": false, "properties": {
          "never_started": {"type": "boolean"}, "no_side_effects": {"type": "boolean"}, "quiescent": {"type": "boolean"}, "no_handles": {"type": "boolean"},
          "owner_verified": {"type": "boolean"}, "generation_verified": {"type": "boolean"}, "liveness_absent": {"type": "boolean"}, "port_absent": {"type": "boolean"},
          "thread_absent": {"type": "boolean"}, "terminal_absent": {"type": "boolean"}, "temp_absent": {"type": "boolean"}, "compute_released": {"type": "boolean"},
          "child_closed": {"type": "boolean"}, "artifact_sealed": {"type": "boolean"}, "target_is_host_session": {"type": "boolean"},
          "identity_result": {"enum": ["MATCH", "PARTIAL", "MISMATCH", "not_applicable"]}, "evidence_refs": {"$ref": "#/$defs/stringRefs"}
        }}, "supersedes_event_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "type", "owner_role", "owner_id", "parent_resource_id", "sublease_ref", "lease_generation", "state", "identity", "created_by_event", "scope", "quota_policy", "cleanup_policy", "last_verified_at", "evidence_refs"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["agent_session", "runtime_thread", "process_tree", "terminal_session", "command_session", "port", "temporary_allocation", "artifact", "constrained_compute"]},
        "owner_role": {"enum": ["root", "child"]}, "owner_id": {"type": "string", "minLength": 1}, "parent_resource_id": {"type": ["string", "null"], "minLength": 1}, "sublease_ref": {"type": ["string", "null"], "minLength": 1},
        "lease_generation": {"type": "integer", "minimum": 1},
        "state": {"enum": ["DECLARED", "LEASED", "START_REQUESTED", "ACTIVE", "QUIESCING", "TERMINATE_REQUESTED", "EXIT_OBSERVED", "RECLAIMING", "RECLAIMED", "RETAINED", "UNKNOWN", "QUARANTINED"]},
        "identity": {"type": "object", "minProperties": 1}, "created_by_event": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "additionalProperties": false, "required": ["purpose", "cwd_logical_id", "timeout_seconds", "temporary_root_logical_id", "stop_condition"], "properties": {"purpose": {"type": "string", "minLength": 1}, "cwd_logical_id": {"type": "string", "minLength": 1}, "timeout_seconds": {"type": "integer", "minimum": 1}, "temporary_root_logical_id": {"type": "string", "minLength": 1}, "stop_condition": {"type": "string", "minLength": 1}}},
        "quota_policy": {"type": "object", "minProperties": 1}, "cleanup_policy": {"type": "object", "minProperties": 1},
        "last_verified_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "evidence_refs": {"$ref": "#/$defs/stringRefs"}
      }
    }
  }
}
