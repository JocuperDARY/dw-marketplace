{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HarnessSessionIdentity2.schema.json",
  "title": "HarnessSessionIdentity2",
  "type": "object",
  "required": ["schema", "schema_version", "harness", "harness_kind", "session_id", "owner_id", "run_id", "lease_generation", "adapter_generation", "harness_instance_id", "launch_nonce"],
  "properties": {
    "schema": { "const": "HarnessSessionIdentity2" },
    "schema_version": { "const": 2 },
    "harness": { "$ref": "#/$defs/non_empty_string" },
    "harness_kind": { "enum": ["agent_session", "runtime_thread"] },
    "session_id": { "$ref": "#/$defs/non_empty_string" },
    "owner_id": { "$ref": "#/$defs/non_empty_string" },
    "run_id": { "$ref": "#/$defs/non_empty_string" },
    "lease_generation": { "$ref": "#/$defs/positive_safe_integer" },
    "adapter_generation": { "$ref": "#/$defs/positive_safe_integer" },
    "harness_instance_id": { "$ref": "#/$defs/non_empty_string" },
    "launch_nonce": { "$ref": "#/$defs/non_empty_string" },
    "agent_id": { "$ref": "#/$defs/non_empty_string" },
    "thread_id": { "$ref": "#/$defs/non_empty_string" },
    "process_identity": { "$ref": "ProcessIdentity2.schema.json" }
  },
  "additionalProperties": false,
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "not": { "pattern": "^[\\u0009\\u000A\\u000B\\u000C\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]*$" }
    },
    "positive_safe_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  },
  "oneOf": [
    {
      "properties": { "harness_kind": { "const": "agent_session" } },
      "required": ["agent_id"],
      "not": { "required": ["thread_id"] }
    },
    {
      "properties": { "harness_kind": { "const": "runtime_thread" } },
      "required": ["thread_id"],
      "not": { "required": ["agent_id"] }
    }
  ]
}
