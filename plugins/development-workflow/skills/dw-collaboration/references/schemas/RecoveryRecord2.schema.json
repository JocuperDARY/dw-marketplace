{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RecoveryRecord2.schema.json",
  "title": "RecoveryRecord2",
  "type": "object",
  "required": ["schema", "schema_version", "resource_id", "resource_type", "run_id", "session_id", "lease_generation", "identity", "cleanup_authority_ref", "teardown_condition", "evidence_refs"],
  "properties": {
    "schema": { "const": "RecoveryRecord2" },
    "schema_version": { "const": 2 },
    "resource_id": { "type": "string", "minLength": 1 },
    "resource_type": { "enum": ["agent_session", "runtime_thread", "process_tree", "command_session", "temporary_allocation"] },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "identity": {
      "oneOf": [
        { "$ref": "ProcessIdentity2.schema.json" },
        { "$ref": "HarnessSessionIdentity2.schema.json" },
        { "$ref": "TemporaryAllocationIdentity2.schema.json" }
      ]
    },
    "cleanup_authority_ref": { "type": "string", "minLength": 1 },
    "teardown_condition": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
