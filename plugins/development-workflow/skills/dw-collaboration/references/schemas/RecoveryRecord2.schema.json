{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RecoveryRecord2.schema.json",
  "title": "RecoveryRecord2",
  "type": "object",
  "required": ["schema", "schema_version", "resource_id", "resource_type", "run_id", "session_id", "lease_generation", "identity", "current_phase", "last_valid_observation", "cleanup_authority_ref", "teardown_condition", "evidence_refs"],
  "properties": {
    "schema": { "const": "RecoveryRecord2" },
    "schema_version": { "const": 2 },
    "resource_id": { "type": "string", "minLength": 1 },
    "resource_type": { "enum": ["agent_session", "runtime_thread", "process_tree", "command_session", "temporary_allocation"] },
    "run_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "identity": {
      "oneOf": [
        { "$ref": "ProcessIdentity2.schema.json" },
        { "$ref": "HarnessSessionIdentity2.schema.json" },
        { "$ref": "TemporaryAllocationIdentity2.schema.json" }
      ]
    },
    "current_phase": {
      "type": "object",
      "required": ["phase", "state"],
      "properties": {
        "phase": { "enum": ["execution", "cleanup"] },
        "state": { "enum": ["ACTIVE", "HOLD", "COMPLETE"] }
      },
      "additionalProperties": false
    },
    "last_valid_observation": {
      "type": "object",
      "required": ["observed_at", "observation_ref", "identity_ref"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "observation_ref": { "type": "string", "pattern": "^observation:[0-9a-f]{64}$" },
        "identity_ref": { "type": "string", "pattern": "^identity:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "cleanup_authority_ref": { "type": "string", "pattern": "^authority:[0-9a-f]{64}$" },
    "teardown_condition": { "enum": ["identity_absence_verified", "harness_closed", "allocation_absence_verified"] },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evidence:[0-9a-f]{64}$" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "resource_type": { "const": "process_tree" } } }, "then": { "properties": { "identity": { "$ref": "ProcessIdentity2.schema.json" } } } },
    { "if": { "properties": { "resource_type": { "const": "command_session" } } }, "then": { "properties": { "identity": { "$ref": "ProcessIdentity2.schema.json" } } } },
    { "if": { "properties": { "resource_type": { "const": "agent_session" } } }, "then": { "properties": { "identity": { "allOf": [{ "$ref": "HarnessSessionIdentity2.schema.json" }, { "properties": { "harness_kind": { "const": "agent_session" } } }] } } } },
    { "if": { "properties": { "resource_type": { "const": "runtime_thread" } } }, "then": { "properties": { "identity": { "allOf": [{ "$ref": "HarnessSessionIdentity2.schema.json" }, { "properties": { "harness_kind": { "const": "runtime_thread" } } }] } } } },
    { "if": { "properties": { "resource_type": { "const": "temporary_allocation" } } }, "then": { "properties": { "identity": { "$ref": "TemporaryAllocationIdentity2.schema.json" } } } }
  ]
}
