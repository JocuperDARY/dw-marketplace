{
  "description": "DW 5 hooks: one read-only session initializer and one high-confidence workflow router",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-router.js\"", "timeout": 5}
        ]
      }
    ]
  }
}
